# Structured configuration. Copy to .env for local dev. NEVER commit .env.
# No production secrets live here; use KMS/secret manager in deployed envs.

# Chain / contracts (concrete addresses pinned in release manifest at deploy; Phase 2 experiment until then)
BASE_CHAIN_ID=
BASE_RPC_URLS=http://localhost:8545
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
HUB_ADDRESS=
FACTORY_ADDRESS=
IMPLEMENTATION_ADDRESS=

# API
PORT=3001
SESSION_SECRET=dev-only-change-me
DATABASE_URL=postgres://midman:midman@localhost:5432/midman
REDIS_URL=redis://localhost:6379

# Encrypted object storage (S3-compatible, e.g. MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=midman-evidence
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
EVIDENCE_KMS_KEY_ID=local-dev-key

# Evidence storage (local encrypted dir by default; S3 when S3_BUCKET set)
EVIDENCE_DIR=./data/evidence
EVIDENCE_KEK_HEX=
S3_BUCKET=
# Receipt signer (server-side ECDSA key for evidence receipts; dev-only ephemeral if unset)
RECEIPT_SIGNER_KEY=
# Reviewer allowlist (comma-separated wallets with evidence read access)
REVIEWER_WALLETS=
# Malware scanner (ClamAV TCP INSTREAM; unset = validation-only, status deferred)
CLAMAV_HOST=
CLAMAV_PORT=3310

# Indexer (verified deployment block at release; address pinned in manifest)
HUB_ADDRESS=
INDEXER_FROM_BLOCK=0

# Automated funding admission (API). ADMISSION_SIGNER_KEY must be the key of
# policies.admissionSigner(); it can only allow new funding, never move funds.
# ADMISSION_PAUSED=1 is the kill switch. Caps are USDC units (6 decimals);
# empty = no cap. AGGREGATE_PAIR_CAP_UNITS_PER_24H (below) caps a buyer/seller pair.
ADMISSION_SIGNER_KEY=
ADMISSION_PAUSED=
ADMISSION_MAX_PRINCIPAL_UNITS=
ADMISSION_MAX_EXPOSURE_UNITS=
ADMISSION_DENYLIST=
ADMISSION_TTL_SECONDS=86400

# HTTP hardening (API). Rate limits are on in production (or RATE_LIMIT_ENABLE=1);
# per-minute per-IP overrides: RATE_LIMIT_AUTH / _CHAIN_READ / _DRAFT_CREATE / _WRITE / _READ.
# TRUST_PROXY: address/CIDR list of the reverse proxy (e.g. Caddy's docker network).
# LOG_LEVEL enables structured request logs (always on in production).
RATE_LIMIT_ENABLE=
TRUST_PROXY=
LOG_LEVEL=

# Outage-watermark keeper (worker). KEEPER_KEY is a dedicated low-balance key
# (never the sponsor key); unset = alert-only. POLICIES_ADDRESS overrides
# hub.policies(). Alert when the watermark lags the feed longer than this.
KEEPER_KEY=
POLICIES_ADDRESS=
OUTAGE_WATERMARK_MAX_LAG_SECONDS=600

# Draft binding pinned server-side (POST /drafts ignores client values for these).
# MIDMAN_POLICY_IDS: JSON {fee,category,readiness,evidence,bond,arbitration,outage,catastrophic}
# MIDMAN_CATEGORY_POLICY_IDS: optional JSON {CATEGORY_NAME: bytes32} per-category policy ids
MIDMAN_POLICY_IDS=
MIDMAN_CATEGORY_POLICY_IDS=

# Phase 10 monitoring / capacity / reliability
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_MS=5000
DEDUPE_WINDOW_SECONDS=900
LARGE_SETTLEMENT_UNITS=10000000000
RULING_PENDING_MAX_SECONDS=172800
REVIEWER_INACTIVITY_SECONDS=259200
RELAY_FAILED_MAX=5
MAX_CONCURRENT_ESCALATED_PER_POD=5
MAX_CONCURRENT_ESCALATED_PROTOCOL=20
AGGREGATE_PAIR_CAP_UNITS_PER_24H=10000000000
MAX_OPEN_RELAY_JOBS=500
MAX_EVIDENCE_OBJECTS=100000
MAX_REVIEWER_PENDING=40
RPC_COOLDOWN_SECONDS=60
GAS_FALLBACK=400000
SPONSOR_DAILY_WEI_CAP=20000000000000000
SPONSOR_BUDGET_FILE=
RELAY_RATE_PER_MIN=30
EVIDENCE_RATE_PER_MIN=10
DUPLICATE_WINDOW_SECONDS=300
RELAY_MAX_BYTES=20000

# Relay sponsorship (baseline gas sponsorship; empty = unsigned direct fallback)
SPONSOR_KEY=
SPONSOR_DAILY_CAP_TXS=50
WORKER_INTERVAL_MS=15000

# Operational role identifiers (isolated credentials per role; see docs/security-baseline.md)
PAUSER_ADDRESS=
ARBITRATION_REGISTRY_ID=
VETO_MULTISIG_ADDRESS=
RELAY_SPONSOR_KEY_ID=
GOVERNANCE_TIMELOCK_ADDRESS=
PLATFORM_FEE_RECIPIENT=
ARBITRATION_COST_RECIPIENT=
